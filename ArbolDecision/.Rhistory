set.seed(123)
fit_rpart <- rpart(label ~ ., data = train,
method = "class",
control = rpart.control(cp = 0.0005,  # árbol más grande
maxdepth = 30,
minbucket = 2))
pred1 <- predict(fit_rpart, newdata = test, type = "class")
acc_rpart <- mean(pred1 == test$label)
cat("Accuracy RPART simple:", acc_rpart, "\n")
sum(is.na(train))  # debería ser 0
sum(is.na(test))
mnist <- read_mnist()
x <- mnist$train$images
y <- mnist$train$labels
# --- Selección estratificada SIN romper la matriz ---
set.seed(123)
idx <- createDataPartition(y, p = 2500/length(y), list = FALSE)
x <- x[idx, , drop = FALSE]   # <-- EVITA CONVERSIÓN A VECTOR
y <- y[idx]
# ================================================
#  Preprocesar: aplanar imágenes a data.frame
# ================================================
x_df <- as.data.frame(x)
colnames(x_df) <- paste0("pixel", seq_len(ncol(x_df)))
data <- data.frame(label = factor(y), x_df)
# ================================================
#  Dividir train / test
# ================================================
set.seed(123)
trainIndex <- createDataPartition(data$label, p = 0.8, list = FALSE)
train <- data[trainIndex, ]
train$label <- factor(train$label)
test  <- data[-trainIndex, ]
test$label  <- factor(test$label, levels = levels(train$label))
# ================================================
#  Modelo 1: RPART básico
# ================================================
set.seed(123)
sum(is.na(data))   # debería ser 0 siempre
pred1 <- predict(fit_rpart, newdata = test, type = "class")
acc_rpart <- mean(pred1 == test$label)
cat("Accuracy RPART simple:", acc_rpart, "\n")
pred1
table(pred1, test$label)
)
fit_rpart <- rpart(label ~ ., data = train,
method = "class",
control = rpart.control(cp = 0.0005,  # árbol más grande
maxdepth = 30,
))
pred1 <- predict(fit_rpart, newdata = test, type = "class")
table(pred1, test$label)
mc <- table(pred1, test$label)
acc_rpart <- mean(pred1 == test$label)
sum(diag(mc))/sum(mc)
# ================================================
#  Modelo 2: Bagging de RPART (Ensemble)
# ================================================
library(ipred)
set.seed(123)
fit_bag <- bagging(
label ~ .,
data = train,
nbagg = 50,               # número de árboles
coob = TRUE,
control = rpart.control(cp = 0, maxdepth = 30)
)
pred2 <- predict(fit_bag, newdata = test, type = "class")
acc_bag <- mean(pred2 == test$label)
cat("Accuracy Bagging RPART:", acc_bag, "\n")
rpart.plot(fit_bag)
rpart.plot(fit_bag[0])
rpart.plot(fit_bag$mtrees)
fit_bag$mtrees
fit_rpart <- rpart(label ~ ., data = train,
method = "class",
control = rpart.control(cp = 0.0005,  # árbol más grande
maxdepth = 100,
))
fit_rpart <- rpart(label ~ ., data = train,
method = "class",
control = rpart.control(cp = 0.000005,  # árbol más grande
maxdepth = 30,
))
pred1 <- predict(fit_rpart, newdata = test, type = "class")
acc_rpart <- mean(pred1 == test$label)
cat("Accuracy RPART simple:", acc_rpart, "\n")
