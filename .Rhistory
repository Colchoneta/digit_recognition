library(caret)
library(caretEnsemble)
library(e1071)
data <- iris
data <- data[data$Species %in% c("virginica", "versicolor"),]
data$Species <- ifelse(data$Species == "virginica", "C0", "C1")
View(data)
data$Species <- as.factor(data$Species)
control <- trainControl(
method = "cv",
number = 10,
classProbs = TRUE,
summaryFunction = twoClassSummary,
savePredictions = "final"
)
set.seed(200)
adaboost <- train(
Species ~ .,
data = data,
method = "gbm",
trControl = control,
tuneGrid = expand.grid(
interaction.depth = 1,     # Profundidad del árbol (stump = 1)
n.trees = 10,             # 10 clasificadores débiles
shrinkage = 0.1,          # Tasa de aprendizaje
n.minobsinnode = 10       # Mínimo observaciones por nodo terminal
),
verbose = FALSE,
metric = "ROC"
)
predict(adaboost, dtest)
summary(adaboost)
adaboost$trees
adaboost$weights
adaboost$importance
adaboost$trees
