library(adabag)
data <- iris
data <- data[data$Species %in% c("virginica", "versicolor"),]
data$Species <- ifelse(data$Species == "virginica", -1, 1)
View(data)
data$Species <- as.factor(data$Species)
ind <- sample(100,100)
idt <- ind[1:10]
dtrain <- data[-idt,]
dtest <- data[idt,]
set.seed(200)
adaboost <- boosting(
Species ~ .,
data = dtrain,
boos = TRUE,
mfinal = 10,
coeflearn = 'Breiman'
)
prediction <- predict(
adaboost,
dtest,
type='Class'
)$class
matrix <- table(
dtest[,"Species"],
prediction
)
matrix
accuracy <- sum(diag(matrix))/sum(matrix)
accuracy
