for (i in 1:n_classifiers) {
bootstrap_indices <- sample(1:nrow(train_data), nrow(train_data), replace = TRUE)
bootstrap_data <- train_data[bootstrap_indices, ]
svm_model <- svm(Species ~ .,
data = bootstrap_data,
kernel = "linear",
cost = 0.1,
scale = TRUE)
svm_models[[i]] <- svm_model
}
set.seed(456)
alpha <- alpha / sum(alpha)
print(alpha)
predictions_matrix <- matrix(0, nrow = nrow(test_data), ncol = n_classifiers)
for (i in 1:n_classifiers) {
pred <- predict(svm_models[[i]], test_data)
pred_numeric <- as.numeric(as.character(pred))
predictions_matrix[, i] <- pred_numeric
}
final_predictions <- sign(predictions_matrix %*% alpha)
final_predictions <- as.factor(final_predictions)
levels(final_predictions) <- c("-1", "1")
accuracy <- mean(final_predictions == test_data$Species)
table(Predicho = final_predictions, Real = test_data$Species)
