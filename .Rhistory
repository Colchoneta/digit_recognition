ctrl <- trainControl(
method = "repeatedcv", #val cruzada de 10 particiones
repeats = 5, # repetir val cruzada  5 veces
summaryFunction = twoClassSummary, #  métrica eval (auc)
classProbs = TRUE # usar probs para clases
)
#train and tune the  SVM
svm.tune <- train(
formula = Species ~ .,
data = data,
method = "svmRadial", # SVM con kernel radial
tuneLength = 5, # buscar entre 5 valores para los hiperparam
preProc = c("center", "scale"), # escalar y centrar los datos
metric = "ROC", # optimizar AUC
trControl = ctrl # conf de val cruzada
)
levels(data$Species)
#ensemble
#setup for cross validation
ctrl <- trainControl(
method = "repeatedcv", #val cruzada de 10 particiones
repeats = 5, # repetir val cruzada  5 veces
summaryFunction = twoClassSummary, #  métrica eval (auc)
classProbs = TRUE # usar probs para clases
)
#train and tune the  SVM
svm.tune <- train(
formula = Species ~ .,
data = data,
method = "svmRadial", # SVM con kernel radial
tuneLength = 5, # buscar entre 5 valores para los hiperparam
preProc = c("center", "scale"), # escalar y centrar los datos
metric = "ROC", # optimizar AUC
trControl = ctrl # conf de val cruzada
)
set.seed(123)
n_folds <- 10
n_repeats <- 5
results <- matrix(0, nrow = n_repeats, ncol = n_folds)
for (rep in 1:n_repeats) {
folds <- sample(rep(1:n_folds, length.out = nrow(data)))
for (fold in 1:n_folds) {
# Dividir datos
train_idx <- which(folds != fold)
test_idx <- which(folds == fold)
# Escalar datos (importante para SVM)
train_data <- data[train_idx, ]
test_data <- data[test_idx, ]
# Escalar usando media y desviación del conjunto de entrenamiento
means <- apply(train_data[, 1:4], 2, mean)
sds <- apply(train_data[, 1:4], 2, sd)
train_scaled <- as.data.frame(scale(train_data[, 1:4], center = means, scale = sds))
test_scaled <- as.data.frame(scale(test_data[, 1:4], center = means, scale = sds))
train_scaled$Species <- train_data$Species
test_scaled$Species <- test_data$Species
# Entrenar SVM
svm_model <- svm(
Species ~ .,
data = train_scaled,
kernel = "radial",
type = "C-classification"
)
# Predecir
pred <- predict(svm_model, test_scaled)
# Calcular precisión
results[rep, fold] <- mean(pred == test_scaled$Species)
}
}
# Calcular métricas
cat("Resultados de validación cruzada (10-fold, 5 repeticiones):\n")
cat("Precisión media:", mean(results), "\n")
cat("Desviación estándar:", sd(as.vector(results)), "\n")
# Entrenar modelo final con todos los datos
data_scaled <- as.data.frame(scale(data[, 1:4]))
data_scaled$Species <- data$Species
final_svm <- svm(
Species ~ .,
data = data_scaled,
kernel = "radial",
type = "C-classification",
probability = TRUE
)
# Resumen del modelo final
print(final_svm)
# Dividir en entrenamiento y prueba (80% entrenamiento, 20% prueba)
set.seed(123)
train_indices <- sample(1:nrow(data), 0.8 * nrow(data))
train_data <- data[train_indices, ]
test_data <- data[-train_indices, ]
# Ahora, vamos a crear 10 subconjuntos de entrenamiento (bootstrapping)
n_classifiers <- 10
svm_models <- list()
for (i in 1:n_classifiers) {
# Muestreo con reemplazo (bootstrapping) del conjunto de entrenamiento
bootstrap_indices <- sample(1:nrow(train_data), nrow(train_data), replace = TRUE)
bootstrap_data <- train_data[bootstrap_indices, ]
# Entrenar SVM con kernel lineal y costo bajo
svm_model <- svm(Species ~ .,
data = bootstrap_data,
kernel = "linear",
cost = 0.1,
scale = TRUE)  # escalar las variables
svm_models[[i]] <- svm_model
}
# Ahora, cargamos los pesos alpha (simulados)
# En un caso real, cargaríamos desde un fichero: alpha <- read.table("alpha.txt")
# Pero aquí simulamos 10 valores positivos que sumen 1 (como si fueran pesos de AdaBoost)
set.seed(456)
alpha <- runif(n_classifiers, 0, 1)
alpha <- alpha / sum(alpha)  # normalizar para que sumen 1
# Mostrar los pesos alpha
print(alpha)
# Realizar predicciones en los datos de prueba (test_data) para cada SVM
predictions_matrix <- matrix(0, nrow = nrow(test_data), ncol = n_classifiers)
for (i in 1:n_classifiers) {
pred <- predict(svm_models[[i]], test_data)
# Convertir las predicciones a valores numéricos: -1 y 1
pred_numeric <- as.numeric(as.character(pred))
predictions_matrix[, i] <- pred_numeric
}
# Combinar las predicciones usando los pesos alpha
# La predicción final es el signo de la combinación lineal de las predicciones ponderadas
final_predictions <- sign(predictions_matrix %*% alpha)
# Convertir a factor para comparar con las etiquetas reales
final_predictions <- as.factor(final_predictions)
levels(final_predictions) <- c("-1", "1")
# Calcular la precisión
accuracy <- mean(final_predictions == test_data$Species)
cat("Precisión en el conjunto de prueba:", accuracy, "\n")
# Matriz de confusión
table(Predicho = final_predictions, Real = test_data$Species)
set.seed(123)
